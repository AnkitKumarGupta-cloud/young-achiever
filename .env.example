NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Parent usernames are mapped to a synthetic email: <username>@<domain>. No email is ever sent.
AUTH_EMAIL_DOMAIN=parents.youngachievers.local
